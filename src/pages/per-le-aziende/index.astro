---
// Pagina per le aziende: parla a chi, in azienda, sceglie un percorso per un manager o un consigliere.
// Indirizzo identico a quello attuale (/per-le-aziende/). Chiavi di ricerca da mantenere:
// vocal coaching aziendale, voice coaching executive, coaching per manager e dirigenti.
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import { site } from '../../data/site';

const title = 'Vocal coaching aziendale per manager e CDA | VCP';
const description = 'Per le risorse umane, un percorso individuale di vocal coaching per un manager o un consigliere, con obiettivi concordati, riservatezza e attivazione aziendale.';

const cases = [
  ['Il consiglio', 'Il direttore tecnico presenta il piano industriale al consiglio di amministrazione. I contenuti sono solidi, ma l\'esposizione non sostiene l\'attenzione e la discussione si sposta altrove prima che le proposte arrivino a una decisione.'],
  ['La fusione', 'Dopo un\'integrazione societaria, il nuovo amministratore delegato si rivolge a due organizzazioni con storie e culture diverse. Il tono con cui comunica le prime decisioni condiziona la fiducia di entrambe.'],
  ['Il passaggio generazionale', 'Il successore designato entra in consiglio con le competenze necessarie. Deve però costruire un\'autorevolezza propria agli occhi di manager che hanno lavorato per anni accanto al fondatore.'],
  ['I grandi clienti', 'Il direttore commerciale guida la trattativa più rilevante dell\'anno. A parità di offerta, la sicurezza con cui sostiene condizioni e prezzo incide in modo diretto sull\'esito della negoziazione.'],
];

const steps = [
  ['Con l\'azienda', 'Il brief', 'Stefano incontra chi in azienda segue il percorso, la direzione del personale o l\'amministratore delegato. Insieme si definiscono il ruolo del manager, i contesti in cui deve essere più efficace e gli obiettivi da raggiungere.'],
  ['Con il manager', 'Il colloquio', 'Stefano incontra il manager che seguirà il percorso. Ascolta come comunica oggi, raccoglie la sua prospettiva e verifica che il percorso individuale sia la risposta adatta.'],
  ['Stefano e il manager', 'Il percorso', 'Sessioni individuali su voce, respirazione, ritmo e struttura del discorso, con The Voice Code™ e MySkema™, costruite sulle situazioni professionali reali del manager.'],
  ['Con l\'azienda', 'Le verifiche', 'Stati di avanzamento periodici sugli obiettivi concordati. All\'azienda arrivano i progressi, mai il contenuto delle sessioni.'],
];

const deliverables = [
  ['Obiettivi scritti e condivisi', 'Prima di iniziare definiamo insieme cosa deve cambiare e in quali contesti. Sono gli stessi obiettivi su cui misuriamo il percorso.'],
  ['Riservatezza verso il team', 'Quello che il manager porta in sessione resta in sessione. È la condizione che gli permette di lavorare davvero sui punti deboli.'],
  ['Stati di avanzamento', 'Aggiornamenti periodici per chi in azienda segue il percorso, utili anche per rendere conto alla direzione dell\'investimento.'],
  ['Un solo interlocutore', 'Stefano segue di persona il brief, il colloquio, le sessioni e i punti di verifica. Nessun passaggio di consegne.'],
];

const admin = [
  ['Un costo d\'impresa', 'La formazione del personale è in linea generale un costo deducibile dal reddito d\'impresa, quando è inerente all\'attività. Un percorso sulla comunicazione di chi guida l\'azienda lo è per natura.'],
  ['Documentazione completa', 'Contratto, fatture e stati di avanzamento descrivono obiettivi, tempi e risultati del percorso. È la documentazione che serve all\'amministrazione per attestarne l\'inerenza.'],
  ['Fatturazione all\'azienda', 'Un percorso definito con costo e durata concordati prima di iniziare, oppure un canone mensile per i programmi che proseguono nel tempo.'],
];

const compare = [
  ['Per chi è pensato', 'Un gruppo eterogeneo, con livelli ed esigenze diverse', 'Una sola persona, con il suo ruolo e i suoi contesti'],
  ['Su cosa si lavora', 'Tecniche generali di public speaking', 'La voce, il ritmo e il discorso di quella persona, nelle sue riunioni reali'],
  ['Riservatezza', 'Il manager si espone davanti ai colleghi', 'Lo spazio è protetto, si lavora anche sulle fragilità'],
  ['Cosa resta', 'Appunti e buoni propositi', 'Strumenti propri, che il manager continua a usare da solo'],
];

const faqs = [
  ['Per quali ruoli è pensato il percorso?', 'Per chi ha una responsabilità che passa dalla parola. Amministratori delegati, direttori, membri di consiglio, responsabili commerciali e manager che guidano team o rappresentano l\'azienda verso clienti, soci e investitori.'],
  ['Si può attivare per più manager della stessa azienda?', 'Sì. Ogni persona segue il proprio percorso individuale, con obiettivi suoi. Stefano non lavora mai in gruppo, perché la voce di ciascuno è diversa e il lavoro funziona solo su misura.'],
  ['Come si misurano i risultati?', 'Sugli obiettivi concordati all\'inizio, osservati nei contesti reali. Per esempio quanto a lungo la persona tiene l\'attenzione in riunione, quante volte viene interrotta, come cambiano le risposte di clienti, team e consiglio. Gli stati di avanzamento li riportano all\'azienda.'],
  ['Cosa viene condiviso con l\'azienda?', 'I progressi rispetto agli obiettivi. Il contenuto delle sessioni resta riservato tra Stefano e la persona, ed è proprio questo che rende il lavoro efficace.'],
  ['Quanto costa un percorso aziendale?', 'Dipende dal numero di persone, dagli obiettivi e dalla durata. La proposta arriva dopo il brief, con costi e tempi definiti prima di iniziare.'],
  ['La spesa è deducibile per l\'azienda?', 'In linea generale sì. La formazione del personale inerente all\'attività è un costo d\'impresa deducibile, e il percorso viene fatturato all\'azienda con tutta la documentazione necessaria. Per il caso specifico fa fede il parere del vostro consulente fiscale.'],
  ['E dopo il vocal coaching?', 'Chi ha completato il percorso può proseguire con il KPI Coaching, dedicato a centratura, presenza fisica e leadership percepita.'],
];

const clients = [
  ['porsche-italia', 'Porsche Italia'], ['autostrade', 'Autostrade per l\'Italia'], ['coop', 'Coop Alleanza 3.0'],
  ['groupama', 'Groupama Assicurazioni'], ['zanichelli', 'Zanichelli'], ['cellularline', 'Cellularline'],
];

const pageUrl = `${site.url}/per-le-aziende/`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Vocal coaching aziendale per manager e dirigenti',
    serviceType: 'Vocal coaching individuale per executive',
    url: pageUrl,
    description,
    provider: { '@id': `${site.url}/#servizio` },
    audience: { '@type': 'BusinessAudience', audienceType: 'Aziende, risorse umane, consigli di amministrazione' },
    areaServed: 'IT',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Per le aziende', item: pageUrl },
    ],
  },
];
---
<Base title={title} description={description} schema={schema} ogImage="/img/og/per-le-aziende.jpg" heroImage="/img/aziende-consiglio.webp">

  <nav class="crumbs" aria-label="Percorso">
    <div class="wrap"><a href="/">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">Per le aziende</span></div>
  </nav>

  <section class="hero hero-hr bg-paper" aria-labelledby="h1">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Per le risorse umane e la direzione</p>
        <h1 id="h1" class="h1">Vocal coaching per i manager della tua azienda</h1>
        <span class="rule" aria-hidden="true"></span>
        <p class="lead">Un percorso individuale per un manager, un direttore o un consigliere. Obiettivi concordati con te, riservatezza verso il team e attivazione a nome dell'azienda.</p>
      </div>
      <figure class="portrait portrait-quote portrait-scene">
        <img src="/img/aziende-consiglio.webp" alt="Una dirigente presenta una decisione strategica in sala riunioni" width="900" height="900" fetchpriority="high" />
        <figcaption>
          <blockquote>“Le parole contano. Ma è il modo in cui voce, ritmo e presenza le rendono credibili a determinare quanto un messaggio venga davvero recepito.”</blockquote>
          <span>Stefano Volpe</span>
        </figcaption>
      </figure>
      <div class="hero-form" id="inizia">
        <LeadForm id="form-hr" ruoloDefault="Risorse Umane / HR" perChiDefault="La mia azienda, per uno o più membri del team" />
      </div>
    </div>
  </section>

  <section class="sec bg-white" aria-labelledby="quando">
    <div class="wrap split">
      <div class="split-head stack">
        <p class="eyebrow">Quando un'azienda chiama Stefano</p>
        <h2 id="quando" class="h2">Competenze solide, voce che non arriva.</h2>
        <p class="muted">Le richieste che arrivano dalle risorse umane si somigliano. La persona è preparata e stimata, ma nei momenti che contano il suo valore si perde tra la sala e le parole.</p>
      </div>
      <ul class="cases">
        {cases.map(([t, d]) => <li class="case"><h3>{t}</h3><p>{d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="sec bg-paper" aria-labelledby="come">
    <div class="wrap stack" style="gap:48px">
      <div class="stack head">
        <p class="eyebrow">Come funziona con l'azienda</p>
        <h2 id="come" class="h2">Quattro passaggi, un solo interlocutore.</h2>
      </div>
      <ol class="hr-steps">
        {steps.map(([k, t, d], i) => (
          <li class="hr-step">
            <span class="hr-num" aria-hidden="true">0{i + 1}</span>
            <div><span class="hr-kick">{k}</span><h3>{t}</h3><p>{d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec bg-navy" aria-labelledby="ricevi">
    <div class="wrap stack" style="gap:48px">
      <div class="stack head">
        <p class="eyebrow">Cosa ricevi</p>
        <h2 id="ricevi" class="h2">Quello che serve a chi segue il percorso in azienda.</h2>
      </div>
      <ul class="deliverables">
        {deliverables.map(([t, d]) => (
          <li><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="11" r="10.5" fill="none" stroke="currentColor" /><path d="M6.5 11.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
            <div><h3>{t}</h3><p>{d}</p></div></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec bg-paper" aria-labelledby="amministrazione">
    <div class="wrap split">
      <div class="split-head stack">
        <p class="eyebrow">Gli aspetti amministrativi</p>
        <h2 id="amministrazione" class="h2">Un investimento semplice da gestire.</h2>
        <p class="muted">Le informazioni che servono all'amministrazione e alla direzione prima di approvare il percorso.</p>
      </div>
      <div class="stack" style="gap:0">
        <ul class="admin">
          {admin.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}
        </ul>
        <p class="admin-note">Le indicazioni fiscali sono di carattere generale. Per il caso specifico fa fede il parere del vostro consulente.</p>
      </div>
    </div>
  </section>

  <section class="sec bg-white" aria-labelledby="confronto">
    <div class="wrap stack" style="gap:40px">
      <div class="stack head">
        <p class="eyebrow">Individuale, mai di gruppo</p>
        <h2 id="confronto" class="h2">Perché un percorso e non un corso.</h2>
        <p class="muted">Un corso di public speaking aziendale parla a tutti. Un percorso individuale lavora sulla voce di chi deve guidare.</p>
      </div>
      <div class="compare" role="table" aria-label="Confronto tra corso di gruppo e percorso individuale">
        <div class="compare-row compare-head" role="row">
          <span role="columnheader"><span class="sr-only">Aspetto</span></span>
          <span role="columnheader">Corso di gruppo</span>
          <span role="columnheader">Percorso con Stefano</span>
        </div>
        {compare.map(([a, b, c]) => (
          <div class="compare-row" role="row">
            <span role="rowheader">{a}</span><span role="cell">{b}</span><span role="cell" class="ours">{c}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec bg-paper" aria-labelledby="fiducia">
    <div class="wrap trust">
      <figure class="story-quote">
        <blockquote>“Il CEO era andato a vedere il mio profilo LinkedIn e poi ha detto all'HR manager: contattami Volpe.”</blockquote>
      </figure>
      <div class="stack">
        <p class="eyebrow">Aziende con cui Stefano ha collaborato</p>
        <h2 id="fiducia" class="h2">Dalla PMI alla holding.</h2>
        <p class="muted">Formatore per la comunicazione di chi guida dal 1988, con collaborazioni che durano anni. Con alcune aziende il lavoro prosegue da oltre un decennio.</p>
        <ul class="client-logos client-logos-3">
          {clients.map(([f, n]) => <li><img src={`/img/clienti/${f}.webp`} alt={n} width="540" height="240" loading="lazy" /></li>)}
        </ul>
        <a class="link" href="/testimonianze/">Le testimonianze di CEO e dirigenti</a>
      </div>
    </div>
  </section>

  <section class="sec bg-white" aria-labelledby="domande">
    <div class="wrap split">
      <div class="split-head stack">
        <p class="eyebrow">Domande frequenti</p>
        <h2 id="domande" class="h2">Prima di proporlo alla direzione.</h2>
        <p class="muted">Le domande che le risorse umane fanno più spesso prima di attivare un percorso.</p>
      </div>
      <div class="faq">
        {faqs.map(([q, a], i) => (
          <details open={i === 0}>
            <summary><h3>{q}</h3></summary>
            <p>{a}{i === faqs.length - 1 && <> <a href="/kpi-coaching/">Scopri il KPI Coaching</a>.</>}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="sec bg-navy closing" aria-labelledby="chiusura">
    <div class="wrap">
      <div class="stack">
        <img class="avatar" src="/img/stefano-volpe.webp" alt="" width="88" height="88" loading="lazy" />
        <h2 id="chiusura" class="h2">Raccontami chi vorresti accompagnare.</h2>
        <p class="lead">Il brief lo conduco io, di persona. Mi bastano il ruolo e il contesto. Giorno e ora li scegli tu, direttamente dalla mia agenda.</p>
      </div>
      <div class="form-wrap"><LeadForm id="form-hr-chiusura" ruoloDefault="Risorse Umane / HR" perChiDefault="La mia azienda, per uno o più membri del team" /></div>
    </div>
  </section>

</Base>
