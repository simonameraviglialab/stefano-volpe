---
// Form in tre passi: chi sei, la situazione, il giorno.
// Passo 2 invia a HubSpot (stesso portale del form attuale), passo 3 apre il calendario Cal.com già compilato.
import { site } from '../data/site';
interface Props { id: string; }
const { id } = Astro.props;
const situazioni = ["Un consiglio o un'assemblea", 'Investitori o soci', 'Una trattativa', 'Il mio team', 'Interventi pubblici e video'];
// value = opzione della proprietà HubSpot ruolo_in_azienda (deve coincidere esattamente)
const ruoli = [
  ['C-Level / Fondatore', 'CEO, C-level o fondatore'],
  ['Direzione / Dirigenza', 'Direzione o dirigenza'],
  ['Manager / Team Leader', 'Manager o team leader'],
  ['Risorse Umane / HR', 'Risorse umane'],
  ['Libero Professionista', 'Libero professionista'],
];
// value = opzione della proprietà HubSpot chi_richiede_il_servizio (serve a Stefano per il prezzo)
const perChi = [
  ['Io, come privato', 'Per me, come privato'],
  ['Io, a nome della mia azienda', 'Per me, a nome della mia azienda'],
  ['La mia azienda, per uno o più membri del team', 'Per una o più persone della mia organizzazione'],
];
---
<form class="form-card lead-form" id={id} novalidate
  data-portal={site.hubspot.portalId} data-guid={site.hubspot.formGuid} data-cal={site.cal}>
  <div class="form-dots" aria-hidden="true"><span class="on"></span><span></span><span></span></div>
  <p class="sr-only" aria-live="polite" data-status>Passo 1 di 3</p>

  <fieldset class="step" data-step="1">
    <legend>Chi sei</legend>
    <div class="fields">
      <div class="field"><label for={`${id}-n`}>Nome e cognome*</label><input id={`${id}-n`} name="fullname" autocomplete="name" required placeholder=" " /></div>
      <div class="field"><label for={`${id}-e`}>Email di lavoro*</label><input id={`${id}-e`} name="email" type="email" autocomplete="email" required placeholder=" " /></div>
    </div>
    <div class="field"><label for={`${id}-r`}>Ruolo*</label>
      <select id={`${id}-r`} name="ruolo_in_azienda" required>
        {ruoli.map(([v, l]) => <option value={v}>{l}</option>)}
      </select>
    </div>
    <div class="field" role="radiogroup" aria-labelledby={`${id}-pc`}>
      <span class="lbl" id={`${id}-pc`}>Per chi è il percorso?*</span>
      <div class="chips chips-col">
        {perChi.map(([v, l]) => <label><input type="radio" name="chi_richiede_il_servizio" value={v} required /><span>{l}</span></label>)}
      </div>
    </div>
    <p class="form-err" data-err hidden>Servono nome, un indirizzo email valido e per chi è il percorso.</p>
    <button type="button" class="btn" data-next>Continua <span aria-hidden="true">→</span></button>
  </fieldset>

  <fieldset class="step" data-step="2" hidden>
    <legend>Dove vuoi essere ascoltato?</legend>
    <div class="chips">
      {situazioni.map((s) => <label><input type="checkbox" name="contesto" value={s} /><span>{s}</span></label>)}
    </div>
    <div class="field"><label for={`${id}-s`}>Raccontami in due righe</label><textarea id={`${id}-s`} name="quale_situazione_vuoi_affrontare_" rows="3" placeholder="Es. Devo presentare al Board un investimento strategico"></textarea></div>
    <button type="submit" class="btn">Scegli giorno e ora <span aria-hidden="true">→</span></button>
  </fieldset>

  <fieldset class="step" data-step="3" hidden>
    <legend>Trenta minuti con Stefano</legend>
    <div data-cal-slot></div>
    <a class="link" data-cal-link href={site.cal} target="_blank" rel="noopener">Apri il calendario in una nuova finestra</a>
  </fieldset>

  <p class="form-note">Valuto ogni richiesta personalmente. Stefano</p>
  <p class="form-legal">Puoi annullare l'iscrizione in qualsiasi momento. <a href="/privacy-policy/">Privacy</a></p>
</form>

<script>
  function setup(form: HTMLFormElement) {
    const steps = [...form.querySelectorAll<HTMLFieldSetElement>('.step')];
    const dots = [...form.querySelectorAll('.form-dots span')];
    const status = form.querySelector('[data-status]')!;
    const go = (n: number) => {
      steps.forEach((s, i) => (s.hidden = i !== n - 1));
      dots.forEach((d, i) => d.classList.toggle('on', i < n));
      status.textContent = `Passo ${n} di 3`;
      const first = steps[n - 1].querySelector<HTMLElement>('input, textarea, iframe');
      first?.focus({ preventScroll: true });
      (window as any).dataLayer?.push({ event: 'vcp_form_step', form_id: form.id, step: n });
    };
    const val = (name: string) => (form.elements.namedItem(name) as HTMLInputElement)?.value.trim() ?? '';

    form.querySelector('[data-next]')!.addEventListener('click', () => {
      const perChi = form.querySelector<HTMLInputElement>('input[name="chi_richiede_il_servizio"]:checked')?.value;
      const ok = val('fullname').length > 1 && /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(val('email')) && !!perChi;
      form.querySelector<HTMLElement>('[data-err]')!.hidden = ok;
      if (ok) go(2);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const [first, ...rest] = val('fullname').split(/\s+/);
      const contesti = [...form.querySelectorAll<HTMLInputElement>('input[name="contesto"]:checked')].map((c) => c.value);
      const motivo = [contesti.join(', '), val('quale_situazione_vuoi_affrontare_')].filter(Boolean).join(' · ');
      const { portal, guid, cal } = form.dataset;
      if (guid) {
        const hutk = document.cookie.match(/hubspotutk=([^;]+)/)?.[1];
        try {
          await fetch(`https://api.hsforms.com/submissions/v3/integration/submit/${portal}/${guid}`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              fields: [
                { name: 'firstname', value: first }, { name: 'lastname', value: rest.join(' ') },
                { name: 'email', value: val('email') }, { name: 'ruolo_in_azienda', value: val('ruolo_in_azienda') },
                { name: 'quale_situazione_vuoi_affrontare_', value: motivo },
                { name: 'chi_richiede_il_servizio', value: form.querySelector<HTMLInputElement>('input[name="chi_richiede_il_servizio"]:checked')?.value ?? '' },
              ],
              context: { pageUri: location.href, pageName: document.title, ...(hutk ? { hutk } : {}) },
            }),
          });
        } catch { /* il calendario si apre comunque */ }
      }
      (window as any).dataLayer?.push({ event: 'vcp_lead', form_id: form.id });
      const url = new URL(cal!);
      url.searchParams.set('name', val('fullname'));
      url.searchParams.set('email', val('email'));
      if (motivo) url.searchParams.set('notes', motivo);
      form.querySelector<HTMLAnchorElement>('[data-cal-link]')!.href = url.href;
      url.searchParams.set('embed', 'true');
      const slot = form.querySelector('[data-cal-slot]')!;
      slot.innerHTML = `<iframe class="cal-frame" title="Calendario di Stefano Volpe" loading="lazy" src="${url.href}"></iframe>`;
      go(3);
    });
  }
  document.querySelectorAll<HTMLFormElement>('.lead-form').forEach(setup);
</script>
